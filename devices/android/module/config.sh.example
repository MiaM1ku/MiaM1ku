# MiaM1ku 设备状态上报配置
# 修改后无需重启：上报进程每个采样周期都会重新读取本文件。

ENDPOINT="https://miam1ku.cn/api/report"
TOKEN=""            # 填写网站的 DEVICE_TOKEN
DEVICE="phone"
MODEL=""            # 留空则读取 ro.product.marketname / ro.product.model
INTERVAL=5          # 采样间隔（秒）；息屏时自动放宽到 15 秒
HEARTBEAT=60        # 状态没变化时的心跳间隔（秒）
MIN_INTERVAL=10     # 两次上报的最小间隔（秒）
HIDE_APPS=""        # 空格分隔的包名，命中时上报为“隐私应用”，例如 "com.tencent.mm org.telegram.messenger"
